# Copy this file to .env.local and fill in real values.

# --- Clerk (Auth / Organizations) ---
# Publishable key is safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret key MUST stay server-side. Never commit the real value.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override Clerk's default sign-in / sign-up routes.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Database (Railway Postgres via Drizzle) ---
DATABASE_URL=postgresql://user:password@host:5432/database

# --- AI reasoning (Evolution Loop) ---
# Without this key, the app runs on a deterministic fake reasoning engine
# (no network, no cost) -- this is the default for local dev, CI, and tests.
# Set it to enable real AI reasoning.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional model overrides. Defaults below are used when unset.
# ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-5
# ANTHROPIC_MODEL_ESCALATED=claude-opus-4-1
# ANTHROPIC_MODEL_JUDGE=claude-opus-4-1
# ANTHROPIC_MAX_OUTPUT_TOKENS=4096
# ANTHROPIC_TIMEOUT_MS=30000

# --- Sentry (error reporting) ---
# Server-side DSN. Required for logger.error() calls to reach Sentry.
SENTRY_DSN=https://xxxxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
# Browser-side DSN (same value, exposed to the client). Required for
# src/instrumentation-client.ts.
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
# Build-time only: uploads source maps so Sentry shows real stack traces.
# Get from Sentry -> Settings -> Auth Tokens (scope: project:releases).
# Omitting this just skips source-map upload; the build still succeeds.
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=kean-on-biz
SENTRY_PROJECT=donna-v7
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

# --- Rate limiting (Upstash Redis, optional) ---
# When BOTH values are set, per-IP rate limiting uses Upstash (shared across
# all serverless instances). When unset, it falls back to a best-effort
# in-memory limiter (per-instance only). Get both from the Upstash console:
#   console.upstash.com -> your Redis database -> "REST API" tab.
UPSTASH_REDIS_REST_URL=https://your-db-name-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXAAIjcDexample_long_token_string
# Optional: max requests per IP per 60s window (default 100).
# RATE_LIMIT_MAX=100

# --- Content-Security-Policy ---
# CSP ships in Report-Only mode by default (violations logged, nothing blocked).
# After deploying and confirming NO violations in the browser console against
# your real Clerk domain, set this to "true" to ENFORCE the policy.
# CSP_ENFORCE=true
# Extra allowed origins (space-separated) if your Clerk/Sentry hosts differ
# from the built-in defaults. Usually only needed for a custom Clerk domain.
# NEXT_PUBLIC_CLERK_CSP_ORIGINS=https://clerk.yourdomain.com https://accounts.yourdomain.com
# NEXT_PUBLIC_SENTRY_CSP_ORIGINS=https://o123456.ingest.us.sentry.io
